# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intake

# "anthropic" or "google"
LLM_PROVIDER=anthropic
# A current model id from your provider's model list. A small, fast model is enough.
LLM_MODEL=
# Set the one that matches LLM_PROVIDER.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional, for the cost line in the eval report: your model's price per million tokens.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
